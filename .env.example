# External port is fixed by docker-compose: 7000 -> container 80
RUSTDESK_ADMIN_PATH=/ops-console

# SQLite (default)
RUSTDESK_DB_DRIVER=sqlite
RUSTDESK_DB=/var/www/data/rustdesk.db

# MySQL (set RUSTDESK_DB_DRIVER=mysql)
RUSTDESK_DB_HOST=mysql
RUSTDESK_DB_PORT=3306
RUSTDESK_DB_NAME=rustdesk
RUSTDESK_DB_USER=rustdesk
RUSTDESK_DB_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
